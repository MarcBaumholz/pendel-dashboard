# Google Cloud: Routes API aktivieren, Key auf "Routes API" beschränken (bleibt auf dem Server)
GOOGLE_MAPS_API_KEY=
# Maps JavaScript API für die Karte; Key auf HTTP-Referrer http://localhost:4321/* beschränken
GOOGLE_MAPS_JS_KEY=
# Optional
# PENDEL_START=Schwaikheim
# PENDEL_ZIEL=Stuttgart Hauptbahnhof
# PENDEL_AUTO_CACHE_SECONDS=180
# PENDEL_PORT=4321
